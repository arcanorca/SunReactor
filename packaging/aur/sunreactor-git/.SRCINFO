pkgbase = sunreactor-git
	pkgdesc = Adaptive screen brightness daemon that follows the sun (DDC/CI and backlight), with CLI/TUI
	pkgver = 0.14.3.r0.g0000000
	pkgrel = 1
	url = https://github.com/arcanorca/SunReactor
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-or-later
	makedepends = git
	makedepends = cargo
	makedepends = cmake
	makedepends = extra-cmake-modules
	makedepends = qt6-base
	makedepends = qt6-declarative
	makedepends = libplasma
	options = !lto
	source = sunreactor-git::git+https://github.com/arcanorca/SunReactor.git
	sha256sums = SKIP

pkgname = sunreactor-git
	install = sunreactor-git.install
	depends = gcc-libs
	depends = glibc
	optdepends = ddcutil: DDC/CI brightness control for external monitors (needs access to /dev/i2c-*)
	optdepends = brightnessctl: backlight control for internal laptop panels
	optdepends = xprintidle: idle detection on X11 sessions
	optdepends = swayidle: idle detection on wlroots compositors
	optdepends = plasma6-applets-sunreactor-git: Plasma 6 widget
	provides = sunreactor
	conflicts = sunreactor

pkgname = plasma6-applets-sunreactor-git
	pkgdesc = Plasma 6 widget for SunReactor adaptive brightness
	depends = sunreactor
	depends = qt6-base
	depends = qt6-declarative
	depends = libplasma
	depends = kirigami
	depends = kcmutils
	provides = plasma6-applets-sunreactor
	conflicts = plasma6-applets-sunreactor
