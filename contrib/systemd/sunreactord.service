[Unit]
Description=sunreactor adaptive brightness daemon
Documentation=https://github.com/arcanorca/SunReactor
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# Paths are rendered by install.sh for the selected installation environment.
Environment=XDG_CONFIG_HOME=@CONFIG_HOME@
Environment=XDG_STATE_HOME=@STATE_HOME@
Environment=XDG_CACHE_HOME=@CACHE_HOME@
ExecStart="@BIN_DIR@/sunreactord"
ExecReload="@BIN_DIR@/sunreactorctl" reload-config
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
WorkingDirectory=%h
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sunreactord

[Install]
WantedBy=default.target
